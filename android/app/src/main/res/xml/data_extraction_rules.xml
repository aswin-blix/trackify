<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ equivalent of allowBackup="false": exclude everything from
  cloud backup and device-to-device transfer. Financial data must never
  leave the device unless the user exports it explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
